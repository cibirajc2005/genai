OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# Set all four values to use Supabase instead of local SQLite/files.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_STORAGE_BUCKET=documents

# Optional bounded agentic features.
AGENTIC_AI_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_MAX_RETRIEVAL_RETRIES=2
AGENT_MAX_TOOL_CALLS=10
